Transcend-DevTest§20260429T135225Z_1eeaac7385244269b33f097127d64cb7§2026-04-29 09:53:55.970000-04:00§2026-04-29§TRDOAE_VIEWS§DARTS_PCAT_Base_V0§V§1§replace view TRDOAE_VIEWS.DARTS_PCAT_Base_V0 asLocking table TRDOAE.DARTS_product_change_at for accessselect /* intermediate fields used for calcs of other final fields *//* Task_Activity_String is composed of 2 parts:1- a substring indicating if any Incomplete tasks exist for each phase/function, followed by2- a substring indicating if any Complete tasks exist for each phase/function.Each part is currently 15 phases x 5 functions = 75 characters.So, any logic interested in complete tasks will need to add 75 to its string offset.Phase order within substring is identical to PHAS.Interphase_Seq.Each part is currently 15 phases x 5 functions = 75 characters, as  follows:01-15 - s/w devel (CHDTR,DESGN, & CODE)16-25 - RCA/PA, SCM26-40 - s/w test (FUNTS, INTTS, REGTS)41-55 - Doc (DOCCD, DOCDS, & DOCWR)56-70 - h/w devel (HRDCD, HRDDS, HRDTS)71-75 - Tech Alert WriteThe functions within each phase are (in order):1- Estimate2- Implement3- Execute (Build or Test)4- Review5- Approve*/Abstract,Actual_Close_Datetime,Author_Person_App_Code,Author_Person_ID,Became_Owner_Datetime,Blocker_Flag,change_app_code1 as change_app_code,Change_Aspect_Code,change_number1 as change_number,jira_app_code1 as Jira_App_Code,jira_change_number1 as Jira_Change_Number,PKey,Class_Code,Close_Reason_Code,Created_Datetime,Cust_Created_Datetime,Customer_Impact_Code,Customer_Synopsis,Defect_Flag,Defer_Targeting_Until_Date,Dependent_On_Flag,Documentation_Change_Flag,Error_Code,Found_In_Activity_Code,Found_In_Phase_Code,Found_Internally_Flag,Hardware_Change_Flag,High_Risk_Flag,Impact_Level_Code,Internal_Doc_Change_Flag,Login_ID,Max_Complete_Function_Code,Max_Complete_Phase_Code,Min_Incomplete_Function_Code,Min_Incomplete_Phase_Code,OAE_Actual_Insert_Datetime,Old_Dep_On_Change_App_Code,Old_Dep_On_Change_Number,Old_Master_Change_App_Code,Old_Master_Change_Number,Old_Regr_Change_App_Code,Old_Regr_Change_Number,Old_Repl_By_Change_App_Code,Old_Repl_By_Change_Number,Owner_Person_App_Code,Owner_Person_ID,pAbstract,pActual_Close_Datetime,pAuthor_Person_App_Code,pAuthor_Person_ID,pBecame_Owner_Datetime,pBlocker_Flag,pChange_Aspect_Code,pClass_Code,pClose_Reason_Code,pCust_Created_Datetime,pCustomer_Impact_Code,pCustomer_Synopsis,pDefect_Flag,pDefer_Targeting_Until_Date,pDependent_On_Flag,pDocumentation_Change_Flag,pError_Code,pFound_In_Activity_Code,pFound_In_Phase_Code,pFound_Internally_Flag,pHardware_Change_Flag,pHigh_Risk_Flag,Physical_Datetime,pImpact_Level_Code,pInternal_Doc_Change_Flag,pMax_Complete_Function_Code,pMax_Complete_Phase_Code,pMin_Incomplete_Function_Code,pMin_Incomplete_Phase_Code,pOld_Dep_On_Change_App_Code,pOld_Dep_On_Change_Number,pOld_Master_Change_App_Code,pOld_Master_Change_Number,pOld_Regr_Change_App_Code,pOld_Regr_Change_Number,pOld_Repl_By_Change_App_Code,pOld_Repl_By_Change_Number,pOwner_Person_App_Code,pOwner_Person_ID,pPreventative_Action_Code,pPrimary_Component_ID,pPrimary_Product_App_Code,pPrimary_Product_ID,pPrimary_Sub_Component_ID,pPriority_Code,pPVC_Activity_String,pRCAPA_Review_Date,pRegression_Flag,pReplaced_By_Flag,pDR_ReadOnly_Flag,pVariation_Test_Flag,pReserved3_Flag,Preventative_Action_Code,Primary_Component_ID,Primary_Product_App_Code,Primary_Product_ID,Primary_Sub_Component_ID,Priority_Code,pRoot_Cause_Code,pSLA_Code,pSoftware_Change_Flag,pSpecial_Access_Flag,pStar_Supplier_Change_Data,pTarget_Close_Datetime,pTask_Activity_String,pTech_Alert_Issued_Flag,pTech_Alert_Required_Flag,PVC_Activity_String,pVendor_Change_Flag,pWorkaround_Available_Flag,pRegression_Risk_Code,RCAPA_Review_Date,Regression_Flag,Replaced_By_Flag,DR_ReadOnly_Flag,Variation_Test_Flag,Reserved3_Flag,Root_Cause_Code,Session_Number,SLA_Code,Software_Change_Flag,Special_Access_Flag,SQL_DML_Code,Star_Supplier_Change_Data,Target_Close_Datetime,Task_Activity_String,Tech_Alert_Issued_Flag,Tech_Alert_Required_Flag,Vendor_Change_Flag,Workaround_Available_Flag,pIncomplete_Task_String,pComplete_Task_String,pTest_Exec_Complete_Flag,pDocwr_Impl_Complete_Flag,pHrdts_Exec_Complete_Flag,pSoftware_Task_Flag,pDocumentation_Task_Flag,pHardware_Task_Flag,pCM_Task_Flag,pTA_Task_Flag,pCode_Impl_Complete_Flag,pCode_Impl_InComplete_Flag,pCM_Impl_Complete_Flag,pCM_Impl_Incomplete_Flag,pCM_Exec_Complete_Flag,pCM_Exec_Incomplete_Flag,pB4_Code_Impl_Complete_Flag,pB4_Code_Impl_Incomplete_Flag,pSoftware_Status_Code,pAll_Tasks_Complete_Flag,Incomplete_Task_String,Complete_Task_String,Test_Exec_Complete_Flag,Docwr_Impl_Complete_Flag,Hrdts_Exec_Complete_Flag,Software_Task_Flag,Documentation_Task_Flag,Hardware_Task_Flag,CM_Task_Flag,TA_Task_Flag,Code_Impl_Complete_Flag,Code_Impl_InComplete_Flag,CM_Impl_Complete_Flag,CM_Impl_Incomplete_Flag,CM_Exec_Complete_Flag,CM_Exec_Incomplete_Flag,B4_Code_Impl_Complete_Flag,B4_Code_Impl_Incomplete_Flag,Software_Status_Code,All_Tasks_Complete_Flag,Regression_Risk_Codefrom(selectAbstract,Actual_Close_Datetime,Author_Person_App_Code,Author_Person_ID,Became_Owner_Datetime,Blocker_Flag,case when ji.productid is not null and ji.drtype is not null then ji.drtypewhen pc.change_app_code in ('DR','TAR') then change_app_codeelse nullendas change_app_code1,Change_Aspect_Code, case when ji.productid is not null and ji.drnumber is not null then ji.drnumberwhen pc.change_app_code in ('DR','TAR') then change_numberelse nullendas change_number1,case when ji.productid is not null and ji.drtype is not null then ji.jira_app_codewhen ji.productid is not null and ji.drtype is null then nullendas jira_app_code1,case when ji.productid is not null and ji.drnumber is not null then ji.jira_change_numberwhen ji.productid is not null and ji.drnumber is null then nullendas jira_change_number1,COALESCE (Change_app_code1,'') || COALESCE(trim(cast(change_number1 as integer)), '') ||  (case when ( ((change_app_code1) is not null or (change_number1) is not null) and ((JIRA_App_code1) is not null or trim(JIRA_Change_Number1) is not null) ) then '-' else '' end) || COALESCE(JIRA_App_code1, '') || COALESCE(trim(cast(JIRA_Change_Number1 as integer)), '') PKey,Class_Code,Close_Reason_Code,Created_Datetime,Cust_Created_Datetime,Customer_Impact_Code,Customer_Synopsis,Defect_Flag,Defer_Targeting_Until_Date,Dependent_On_Flag,Documentation_Change_Flag,Error_Code,Found_In_Activity_Code,Found_In_Phase_Code,Found_Internally_Flag,Hardware_Change_Flag,High_Risk_Flag,Impact_Level_Code,Internal_Doc_Change_Flag,Login_ID,Max_Complete_Function_Code,Max_Complete_Phase_Code,Min_Incomplete_Function_Code,Min_Incomplete_Phase_Code,OAE_Actual_Insert_Datetime,Old_Dep_On_Change_App_Code,Old_Dep_On_Change_Number,Old_Master_Change_App_Code,Old_Master_Change_Number,Old_Regr_Change_App_Code,Old_Regr_Change_Number,Old_Repl_By_Change_App_Code,Old_Repl_By_Change_Number,Owner_Person_App_Code,Owner_Person_ID,pAbstract,pActual_Close_Datetime,pAuthor_Person_App_Code,pAuthor_Person_ID,pBecame_Owner_Datetime,pBlocker_Flag,pChange_Aspect_Code,pClass_Code,pClose_Reason_Code,pCust_Created_Datetime,pCustomer_Impact_Code,pCustomer_Synopsis,pDefect_Flag,pDefer_Targeting_Until_Date,pDependent_On_Flag,pDocumentation_Change_Flag,pError_Code,pFound_In_Activity_Code,pFound_In_Phase_Code,pFound_Internally_Flag,pHardware_Change_Flag,pHigh_Risk_Flag,Physical_Datetime,pImpact_Level_Code,pInternal_Doc_Change_Flag,pMax_Complete_Function_Code,pMax_Complete_Phase_Code,pMin_Incomplete_Function_Code,pMin_Incomplete_Phase_Code,pOld_Dep_On_Change_App_Code,pOld_Dep_On_Change_Number,pOld_Master_Change_App_Code,pOld_Master_Change_Number,pOld_Regr_Change_App_Code,pOld_Regr_Change_Number,pOld_Repl_By_Change_App_Code,pOld_Repl_By_Change_Number,pOwner_Person_App_Code,pOwner_Person_ID,pPreventative_Action_Code,pPrimary_Component_ID,pPrimary_Product_App_Code,pPrimary_Product_ID,pPrimary_Sub_Component_ID,pPriority_Code,pPVC_Activity_String,pRCAPA_Review_Date,pRegression_Flag,pReplaced_By_Flag,pDR_ReadOnly_Flag,pVariation_Test_Flag,pReserved3_Flag,Preventative_Action_Code,Primary_Component_ID,Primary_Product_App_Code,Primary_Product_ID,Primary_Sub_Component_ID,Priority_Code,pRoot_Cause_Code,pSLA_Code,pSoftware_Change_Flag,pSpecial_Access_Flag,pStar_Supplier_Change_Data,pTarget_Close_Datetime,pTask_Activity_String,pTech_Alert_Issued_Flag,pTech_Alert_Required_Flag,PVC_Activity_String,pVendor_Change_Flag,pWorkaround_Available_Flag,pRegression_Risk_Code,RCAPA_Review_Date,Regression_Flag,Replaced_By_Flag,DR_ReadOnly_Flag,Variation_Test_Flag,Reserved3_Flag,Root_Cause_Code,Session_Number,SLA_Code,Software_Change_Flag,Special_Access_Flag,SQL_DML_Code,Star_Supplier_Change_Data,Target_Close_Datetime,Task_Activity_String,Tech_Alert_Issued_Flag,Tech_Alert_Required_Flag,Vendor_Change_Flag,Workaround_Available_Flag,substring(ptask_activity_string from 1 for 75)as pIncomplete_Task_String,substring(ptask_activity_string from 76 for 75)as pComplete_Task_String,substring(ptask_activity_string from 75+38 for 1)as pTest_Exec_Complete_Flag,substring(ptask_activity_string from 75+52 for 1)as pDocwr_Impl_Complete_Flag,substring(ptask_activity_string from 75+68 for 1)as pHrdts_Exec_Complete_Flag,casewhen substring(ptask_activity_string from 01 for 40) ||substring(ptask_activity_string from 75+01 for 40) ='NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN' ||'NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN'then 'N'else 'Y'endas pSoftware_Task_Flag,casewhen substring(ptask_activity_string from 41 for 15) ||substring(ptask_activity_string from 75+41 for 15) ='NNNNNNNNNNNNNNN' ||'NNNNNNNNNNNNNNN'then 'N'else 'Y'endas pDocumentation_Task_Flag,casewhen substring(ptask_activity_string from 56 for 15) ||substring(ptask_activity_string from 75+56 for 15) ='NNNNNNNNNNNNNNN' ||'NNNNNNNNNNNNNNN'then 'N'else 'Y'endas pHardware_Task_Flag,casewhen substring(ptask_activity_string from 21 for 5) ||substring(ptask_activity_string from 75+21 for 5) ='NNNNN' ||'NNNNN'then 'N'else 'Y'endas pCM_Task_Flag,casewhen substring(ptask_activity_string from 71 for 5) ||substring(ptask_activity_string from 75+71 for 5) ='NNNNN' ||'NNNNN'then 'N'else 'Y'endas pTA_Task_Flag,substring(ptask_activity_string from 75+12 for 1)as pCode_Impl_Complete_Flag,substring(ptask_activity_string from 12 for 1)as pCode_Impl_InComplete_Flag,substring(ptask_activity_string from 75+22 for 1)as pCM_Impl_Complete_Flag,substring(ptask_activity_string from 22 for 1)as pCM_Impl_Incomplete_Flag,substring(ptask_activity_string from 75+23 for 1)as pCM_Exec_Complete_Flag,substring(ptask_activity_string from 23 for 1)as pCM_Exec_Incomplete_Flag,casewhen substring(ptask_activity_string from 75+01 for 11) like '%Y%' -- ignore Ps then 'Y'else 'N'endas pB4_Code_Impl_Complete_Flag,casewhen substring(ptask_activity_string from 01 for 11) = 'NNNNNNNNNNN' then 'N'else 'Y'endas pB4_Code_Impl_Incomplete_Flag,case-- 5-2-04: adjustment made to accommodate SCM/EXEC auto taskswhen  pCode_Impl_Complete_Flag='Y' AND( pCM_Task_Flag='N' or(pCM_Exec_Complete_Flag='Y' and pCM_Impl_Incomplete_Flag='N') or(pCM_Impl_Complete_Flag='Y' and pCM_Exec_Incomplete_Flag='N') )THEN  'STVTEST'when  pCode_Impl_Complete_Flag='Y' ANDpCM_Exec_Incomplete_Flag='Y'then  'BUILD'  -- value while awaiting automatic SCM buldwhen  pCode_Impl_Complete_Flag='Y' THEN  'CMWAIT'when  pCode_Impl_Incomplete_Flag    ='Y' AND(pB4_Code_Impl_Complete_Flag   ='Y' OR -- any prior task completion moves status uppB4_Code_Impl_Incomplete_Flag ='N'    -- no task exists prior to CODE/IMPL) THEN  'OPEN'ELSE  'WAIT'endas pSoftware_Status_Code,casewhen pincomplete_task_string not like '%Y%' and pcomplete_task_string       like '%Y%'then 'Y'else 'N'endas pAll_Tasks_Complete_Flag,substring(task_activity_string from 1 for 75)as Incomplete_Task_String,substring(task_activity_string from 76 for 75)as Complete_Task_String,substring(task_activity_string from 75+38 for 1)as Test_Exec_Complete_Flag,substring(task_activity_string from 75+52 for 1)as Docwr_Impl_Complete_Flag,substring(task_activity_string from 75+68 for 1)as Hrdts_Exec_Complete_Flag,casewhen substring(task_activity_string from 01 for 40) ||substring(task_activity_string from 75+01 for 40) ='NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN' ||'NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN'then 'N'else 'Y'endas Software_Task_Flag,casewhen substring(task_activity_string from 41 for 15) ||substring(task_activity_string from 75+41 for 15) ='NNNNNNNNNNNNNNN' ||'NNNNNNNNNNNNNNN'then 'N'else 'Y'endas Documentation_Task_Flag,casewhen substring(task_activity_string from 56 for 15) ||substring(task_activity_string from 75+56 for 15) ='NNNNNNNNNNNNNNN' ||'NNNNNNNNNNNNNNN'then 'N'else 'Y'endas Hardware_Task_Flag,casewhen substring(task_activity_string from 21 for 5) ||substring(task_activity_string from 75+21 for 5) ='NNNNN' ||'NNNNN'then 'N'else 'Y'endas CM_Task_Flag,casewhen substring(task_activity_string from 71 for 5) ||substring(task_activity_string from 75+71 for 5) ='NNNNN' ||'NNNNN'then 'N'else 'Y'endas TA_Task_Flag,substring(task_activity_string from 75+12 for 1)as Code_Impl_Complete_Flag,substring(task_activity_string from 12 for 1)as Code_Impl_InComplete_Flag,substring(task_activity_string from 75+22 for 1)as CM_Impl_Complete_Flag,substring(task_activity_string from 22 for 1)as CM_Impl_Incomplete_Flag,substring(task_activity_string from 75+23 for 1)as CM_Exec_Complete_Flag,substring(task_activity_string from 23 for 1)as CM_Exec_Incomplete_Flag,casewhen substring(task_activity_string from 75+01 for 11) like '%Y%' -- ignore Ps then 'Y'else 'N'endas B4_Code_Impl_Complete_Flag,casewhen substring(task_activity_string from 01 for 11) = 'NNNNNNNNNNN' then 'N'else 'Y'endas B4_Code_Impl_Incomplete_Flag,case-- 5-2-04: adjustment made to accommodate SCM/EXEC auto taskswhen  Code_Impl_Complete_Flag='Y' AND( CM_Task_Flag='N' or(CM_Exec_Complete_Flag='Y' and CM_Impl_Incomplete_Flag='N') or(CM_Impl_Complete_Flag='Y' and CM_Exec_Incomplete_Flag='N') )THEN  'STVTEST'when  Code_Impl_Complete_Flag='Y' ANDCM_Exec_Incomplete_Flag='Y'then  'BUILD'  -- value while awaiting automatic SCM buldwhen  Code_Impl_Complete_Flag='Y' THEN  'CMWAIT'when  Code_Impl_Incomplete_Flag    ='Y' AND(B4_Code_Impl_Complete_Flag   ='Y' OR -- any prior task completion moves status upB4_Code_Impl_Incomplete_Flag ='N'    -- no task exists prior to CODE/IMPL) THEN  'OPEN'ELSE  'WAIT'endas Software_Status_Code,casewhen incomplete_task_string not like '%Y%' and complete_task_string       like '%Y%'then 'Y'else 'N'endas All_Tasks_Complete_Flag,Regression_Risk_Codefrom TRDOAE.DARTS_product_change_at pcleft outer join Trdoae_Views.Darts_D2jissue_V0 jion ji.drtype = pc.change_app_code and ji.drnumber = pc.change_number and ji.productid = pc.primary_product_id) temp;ENDREC                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
