[Unit]
Description=SCION — Structural Change Intelligence & Observability Node
Documentation=https://github.com/GuilleAlbella/SCION
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes

# WorkingDirectory must contain docker-compose.yml.
# Default matches the path used by install.sh (SCION_INSTALL_DIR).
WorkingDirectory=/opt/scion

# Loads SCION_PUBLIC_PORT, API_KEY, LOG_LEVEL, etc. from .env at start
# time. The leading "-" means systemd ignores a missing file (safe for
# fresh installs before .env is configured).
EnvironmentFile=-/opt/scion/.env

ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down --timeout 30

# Pull latest images then restart (used by: systemctl reload scion).
ExecReload=/usr/bin/docker compose pull --quiet
ExecReload=+/usr/bin/docker compose up -d --remove-orphans

TimeoutStartSec=300
TimeoutStopSec=120
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
