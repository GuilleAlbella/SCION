# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/

# Database
*.db
# SQLite WAL mode auxiliaries — created at runtime, never committed.
*.db-wal
*.db-shm
*.db-journal

# Environment
.env
.env.local
frontend/.env.local

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Build artifacts
# .pptx excluded globally — same content lives in docs/*.pdf and PPTX
# files routinely exceed GitHub's 100 MB hard limit.
*.pptx
# Keep .pdf and .docx tracked under docs/ — exclude only at root.
/*.pdf
/*.docx

# Claude
.claude/

# Images
img/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Coverage
htmlcov/
.coverage
coverage/

# Next.js
frontend/.swc/
frontend/next-env.d.ts

# Alembic — keep migrations, ignore local SQLite override
backend/alembic/versions/__pycache__/

# Local secrets backup
*.bak
*.swp

# Parser / dict raw extracts — customer data, never commit. Each
# extract folder can be multiple GB. Keep the Parser/ folder itself
# tracked (so the directory exists in fresh checkouts) but exclude
# every .dat and .log file inside it.
Parser/**/*.dat
Parser/**/*.log
Parser/**/*.json

# Parser team design docs — these live in the parser team's own repo.
# Dropping them here locally for reference is fine; they should not be
# tracked or pushed in the SCION repo.
Parser/docs/

# Local-only credential / secret notes. Catches casual filenames like
# `Token Github.txt`, `secrets.md`, `pat.txt`, `credentials.txt` that
# devs sometimes leave in the repo root while testing. Real secrets
# belong in a password manager — never in the working tree.
*[Tt]oken*
*[Ss]ecret*
*[Pp]assword*
*credentials*
*.pat

# Windows / PowerShell module-analysis cache that the shell drops in
# the repo root when commands are run from this directory. Never
# code, always regenerated.
Microsoft/

# Internal meeting transcripts — kept locally for context but not
# part of the source tree.
Transcripciones/

# Test runner output
tests/results/

# Internal email files
*.msg

# Old Parser extract archives — large data files, not code.
Parser/old/

# Local analysis / scratch folders — not part of the source tree.
Revision BCRA/
bugs/
Screenshot_1.png

# Docker distribution package — belongs in the scion-deploy repo, not here.
docker/

# Non-.md files in docs/ are no longer tracked; prevent re-adding binaries.
docs/*.pdf
docs/*.docx
docs/*.txt
docs/**/*.sql
