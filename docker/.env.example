# SCION — configuración de deploy. Copiar a .env y editar.
# Nunca subir el .env real a ningún repositorio.

# ──── Puerto público (nginx) ────
SCION_PUBLIC_PORT=80

# ──── Región (informativo) ────
DATA_REGION=us-east-1

# ──── Ruta del share en el host ────
# Directorio del host que se monta como /mnt/vm1_share en el backend.
# En Linux/Mac: ruta absoluta (ej. /mnt/datos)
# En Windows:  ruta estilo Docker (ej. C:/datos  o  //c/datos)
SCION_SHARE_HOST_PATH=/tmp/scion_share

# ──── PostgreSQL ────
# Password para el usuario scion de Postgres. Requerido.
# Generar con: openssl rand -hex 32
POSTGRES_PASSWORD=

# ──── Clave de API ────
# Recomendado en cualquier deploy no-local. Generar con:
#   openssl rand -hex 32
# Cuando está seteada, todos los endpoints /api/v1/* la requieren.
API_KEY=

# ──── Misc ────
LOG_LEVEL=info
TZ=UTC
